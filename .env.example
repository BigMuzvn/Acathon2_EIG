# Browser calls the application's server on the same origin (CORS compatible).
VITE_API_BASE_URL=/api
# Optional subscription credentials: put them in .env.local (ignored by Git).
# Server only; never prefix with VITE_.
# CARAPI_API_TOKEN=
# CARAPI_API_SECRET=
# Server protection per instance (optional; shown defaults).
# CARAPI_CLIENT_POINTS_PER_MINUTE=120
# CARAPI_UPSTREAM_PER_MINUTE=240
